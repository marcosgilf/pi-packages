{
  "name": "pi-packages",
  "private": true,
  "description": "Independent Pi Coding Agent packages.",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-session/src/index.ts",
      "./packages/pi-usage/src/index.ts",
      "./packages/pi-footer/src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck",
    "format": "biome check --write .",
    "lint": "biome check . --error-on-warnings",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "publish-packages": "changeset publish",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-server": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "npm-check-updates": "23.1.0",
    "semver": "7.8.5",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "node-domexception": "npm:@profoundlogic/node-domexception@1.0.2",
    "protobufjs": "7.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents": false
  }
}
